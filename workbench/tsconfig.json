{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "local/**/*.ts",
    "local/**/*.tsx",
    "cloudflare-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "local/dist",
    "data"
  ]
}
